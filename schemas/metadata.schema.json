{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/NicoGenti/opencode-orchestrator-kit-evals/schemas/metadata.schema.json",
  "title": "Evaluation run metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kitVersion",
    "kitRef",
    "kitCommit",
    "scenario",
    "modelProfile",
    "executedAt",
    "runnerVersion",
    "status",
    "mode"
  ],
  "properties": {
    "kitVersion": { "type": "string", "minLength": 1 },
    "kitRef": { "type": "string", "minLength": 1 },
    "kitCommit": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "scenario": { "type": "string", "minLength": 1 },
    "modelProfile": { "type": "string", "minLength": 1 },
    "executedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "runnerVersion": { "type": "string", "minLength": 1 },
    "status": { "enum": ["dry-run", "passed", "failed", "partial"] },
    "mode": { "enum": ["dry-run", "live"] }
  }
}
