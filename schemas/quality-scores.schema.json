{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/NicoGenti/opencode-orchestrator-kit-evals/schemas/quality-scores.schema.json",
  "title": "Qualitative scores for one scenario run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mode",
    "taskCompletion",
    "correctness",
    "routing",
    "constraintAdherence",
    "efficiency",
    "safety",
    "total",
    "max"
  ],
  "properties": {
    "mode": { "enum": ["dry-run", "live"] },
    "taskCompletion": { "type": ["integer", "null"], "minimum": 0, "maximum": 3 },
    "correctness": { "type": ["integer", "null"], "minimum": 0, "maximum": 3 },
    "routing": { "type": ["integer", "null"], "minimum": 0, "maximum": 3 },
    "constraintAdherence": { "type": ["integer", "null"], "minimum": 0, "maximum": 3 },
    "efficiency": { "type": ["integer", "null"], "minimum": 0, "maximum": 3 },
    "safety": { "enum": ["pass", "fail", null] },
    "total": { "type": ["integer", "null"], "minimum": 0, "maximum": 15 },
    "max": { "enum": [15, null] }
  },
  "allOf": [
    {
      "if": {
        "properties": { "mode": { "const": "dry-run" } },
        "required": ["mode"]
      },
      "then": {
        "properties": {
          "taskCompletion": { "type": "null" },
          "correctness": { "type": "null" },
          "routing": { "type": "null" },
          "constraintAdherence": { "type": "null" },
          "efficiency": { "type": "null" },
          "safety": { "type": "null" },
          "total": { "type": "null" },
          "max": { "type": "null" }
        }
      },
      "else": {
        "properties": {
          "taskCompletion": { "type": "integer" },
          "correctness": { "type": "integer" },
          "routing": { "type": "integer" },
          "constraintAdherence": { "type": "integer" },
          "efficiency": { "type": "integer" },
          "safety": { "enum": ["pass", "fail"] },
          "total": { "type": "integer" },
          "max": { "const": 15 }
        },
        "required": ["taskCompletion", "correctness", "routing", "constraintAdherence", "efficiency", "safety", "total", "max"]
      }
    }
  ]
}
