{
  "name": "opencode-orchestrator-kit-evals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.0"
  },
  "description": "Reproducible evaluation suite for opencode-orchestrator-kit: regression, token usage, and qualitative agent benchmarks.",
